# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking & linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Build & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Checkpoints and model weights (mandatory constraint)
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx

# Datasets and raw source material
data/*
!data/.gitkeep

# Never commit raw or generated training corpora by default
data/raw/
data/approved/
data/interim/
data/processed/
data/benchmark/

# Local source downloads and archives
scripts/sources/

# Generated model artifacts and checkpoints
artifacts/*
!artifacts/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Credentials and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Generated artifacts and experiment outputs
artifacts/*
!artifacts/.gitkeep

# Logs and environment dumps
*.log
*.sqlite3

# IDE and OS metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
