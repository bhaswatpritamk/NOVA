{
  "name": "nova-20m-colab-pilot",
  "version": "1.0.0",
  "data_dir": "data/prepared_expanded",
  "output_dir": "checkpoints/colab_20m_pilot",
  "tokenizer_path": "artifacts/final_tokenizer",
  "manifest_path": "data/prepared_expanded/manifest.json",
  "model_config_path": "configs/nova_20m.json",
  "batch_size": 2,
  "max_seq_len": 512,
  "gradient_accumulation_steps": 2,
  "max_steps": 5,
  "learning_rate": 0.0003,
  "min_learning_rate": 0.00003,
  "weight_decay": 0.01,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-8,
  "max_grad_norm": 1.0,
  "warmup_steps": 2,
  "lr_schedule": "cosine",
  "eval_interval": 0,
  "save_interval": 5,
  "save_step_checkpoints": false,
  "seed": 42,
  "device": "auto",
  "mixed_precision": "fp16",
  "notes": "Nova Phase 9 feasibility check configuration for the 20.3M parameter model on Google Colab (5 steps bounded)."
}
