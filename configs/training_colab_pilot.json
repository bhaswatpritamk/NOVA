{
  "name": "nova-colab-training-pilot",
  "version": "1.0.0",
  "data_dir": "data/prepared_expanded",
  "output_dir": "checkpoints/colab_pilot",
  "tokenizer_path": "artifacts/final_tokenizer",
  "manifest_path": "data/prepared_expanded/manifest.json",
  "model_config_path": "configs/prototype_model.json",
  "batch_size": 4,
  "max_seq_len": 512,
  "gradient_accumulation_steps": 1,
  "max_steps": 20,
  "learning_rate": 0.0005,
  "min_learning_rate": 0.00005,
  "weight_decay": 0.01,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-8,
  "max_grad_norm": 1.0,
  "warmup_steps": 5,
  "lr_schedule": "cosine",
  "eval_interval": 10,
  "save_interval": 10,
  "save_step_checkpoints": true,
  "seed": 42,
  "device": "auto",
  "mixed_precision": "fp16",
  "notes": "Nova Phase 9 controlled pilot training configuration on Google Colab (auto GPU/CPU, fp16/fp32 fallback, 20 steps bounded)."
}
