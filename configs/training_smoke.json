{
  "name": "nova-fit-training-smoke",
  "version": "0.1.0",
  "data_dir": "data/prepared_final",
  "output_dir": "checkpoints/smoke",
  "tokenizer_path": "artifacts/final_tokenizer",
  "manifest_path": "data/prepared_final/manifest.json",
  "batch_size": 2,
  "max_seq_len": 512,
  "gradient_accumulation_steps": 1,
  "max_steps": 10,
  "learning_rate": 0.001,
  "min_learning_rate": 0.0001,
  "weight_decay": 0.01,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-8,
  "max_grad_norm": 1.0,
  "warmup_steps": 2,
  "lr_schedule": "cosine",
  "eval_interval": 5,
  "save_interval": 5,
  "save_step_checkpoints": true,
  "seed": 42,
  "device": "cpu",
  "notes": "Nova-Fit Phase 5 pretraining engine smoke test configuration on CPU."
}
